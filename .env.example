DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True
DB_NAME=clinic_management_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Local demo: email links are printed in Django terminal, not delivered.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL=Clinic <no-reply@localhost>
# Real sending: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
